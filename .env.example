# ===== 本機開發用（IntelliJ EnvFile / ./mvnw spring-boot:run）=====
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/your_database_name
SPRING_DATASOURCE_USERNAME=your_username
SPRING_DATASOURCE_PASSWORD=your_password
SERVER_PORT=8080

JWT_SECRET=至少32字元的隨機字串

# 啟動時若此帳號不存在就建立為 ADMIN；兩個都留空則不建立任何管理員
# docker-compose 的 backend 也會透過 env_file 讀到這兩個變數
APP_ADMIN_ACCOUNT=
APP_ADMIN_PASSWORD=

# ===== Docker 環境用（docker-compose.yml 會讀取）=====
# 資料庫名稱 myjdbc 與帳號 root 需和 docker-compose.yml 中 db service 的設定一致
DOCKER_DATASOURCE_URL=jdbc:mysql://db:3306/your_database_name?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Taipei&characterEncoding=utf-8
DOCKER_DATASOURCE_USERNAME=your_username
DOCKER_DATASOURCE_PASSWORD=your_password
# 前端 API 位址，在「映像 build 時」寫死進 JS（改了要重新 build frontend）
# 留空 = 同源：瀏覽器直接打 /api/...，由 nginx 轉給 backend（compose 部署用這個）
# 舊 .env 若殘留 http://localhost:80 之類的網址，會變成跨來源而被 CORS 擋掉
# 此值由 docker-compose.yml 以 build.args（${VITE_API_URL:-}）讀取，未設定時同樣為空字串
VITE_API_URL=
# compose 使用的映像 tag（backend、frontend 共用），未設定或留空時為 latest
# 可填 latest，或 CI 推送的完整 40 碼 commit SHA tag（例如 0123456789abcdef0123456789abcdef01234567），用於回退到指定版本
# SHA tag 格式與 CI 的 ${{ github.sha }} 相同，不加 sha- 前綴、不縮短
IMAGE_TAG=latest
